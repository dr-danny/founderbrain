# .env.founderbrain.example
#
# Environment variables read by FounderBrain (`src/founderbrain/config.ts` and
# the Worker). The root `.env.example` is for the inherited Launchhouse runtime
# only — do not mix the two.
#
# THERE ARE NO VALUES IN THIS FILE AND THERE NEVER WILL BE. Copy to a private
# `.env` (or set Railway / Wrangler secrets) and fill from a password manager.
#
# Auth is Hexclave only. Supabase is out of scope — do not add SUPABASE_URL,
# SUPABASE_ANON_KEY, or similar. See docs/founderbrain/RAILWAY-CLOUDFLARE.md
# (Auth decision) and issues #36 (won't do) / #38 (Hexclave).


# =========================================================================================
# Runtime
# =========================================================================================

# One of: development, test, production. Default production.
NODE_ENV=

# Must be UTC for FounderBrain processes.
TZ=

# Listen port. Railway injects this; default 8080 when unset.
PORT=

# Exact approved HTTPS origin of the Worker / custom domain (no trailing slash).
# Required. Local demo may use http://127.0.0.1:<port>.
APP_ORIGIN=

# Shared secret (>= 32 chars) so only the Cloudflare Worker can call /api/*.
# Required in production. Omit only with FOUNDERBRAIN_LOCAL_DEMO=true.
ORIGIN_SECRET=

# When true, API accepts X-Dev-User on loopback for local UI work without Hexclave.
# Forbidden when NODE_ENV=production.
FOUNDERBRAIN_LOCAL_DEMO=


# =========================================================================================
# Database and encryption
# =========================================================================================

# Private Postgres URL using the fb_runtime role (never the admin URL in the API).
DATABASE_URL=

# Disposable Postgres for `npm run fb:test` storage/API suites. Unset => those tests skip.
FB_TEST_DATABASE_URL=

# Admin URL for one-off migrations only (local script / CI / migration job).
MIGRATION_DATABASE_URL=

# Role name granted by migrate: fb_runtime or fb_worker.
RUNTIME_DB_ROLE=

# 32-byte base64 master key that wraps per-workspace data keys. Escrow offline.
GE_MASTER_KEY=


# =========================================================================================
# Hexclave identity (required in production; not used when FOUNDERBRAIN_LOCAL_DEMO=true)
# =========================================================================================

# Hexclave project UUID from the dashboard URL after /projects/.
# Token audience and workspace key namespace. Not a secret; wrong id means nobody signs in.
HEXCLAVE_PROJECT_ID=

# Bare HTTPS origin of the Hexclave API. Default https://api.hexclave.com.
# Must match the Worker var of the same name (CSP connect-src).
HEXCLAVE_API_URL=

# Optional. Only if the project requires a publishable client key (pck_...).
# Safe in the browser. Never set an ssk_ server key on Railway for v1.
HEXCLAVE_PUBLISHABLE_CLIENT_KEY=


# =========================================================================================
# Cloudflare Worker (wrangler / dashboard vars — not all read by config.ts)
# =========================================================================================

# Fixed HTTPS Railway API origin. Never client-controlled.
API_ORIGIN=

# Same value as API ORIGIN_SECRET.
# ORIGIN_SECRET=

# Bare HTTPS Hexclave API origin for CSP (same rule as API HEXCLAVE_API_URL).
# HEXCLAVE_API_URL=


# =========================================================================================
# AI generation via OpenRouter (disabled until spend is approved — see #24)
# =========================================================================================

# Default false. Worker refuses to start when true without the rest of this block.
AI_ENABLED=

# Management key used only to create/revoke per-user inference keys. Never send to the browser.
# Secret name in Railway: OPENROUTER_MANAGEMENT_KEY
OPENROUTER_MANAGEMENT_KEY=

# Privacy-allowlisted role models (defaults exist in openrouter-privacy.ts).
# AI_MODEL is accepted as an alias for AI_MODEL_RUNNER.
AI_MODEL_THINKER=
AI_MODEL_RUNNER=
AI_MODEL=
AI_MODEL_VERIFIER=

AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_WORKSPACE_DAILY_MICROUSD=
AI_GLOBAL_DAILY_MICROUSD=

# Per-user keys (created automatically on signup):
#   name: OneDay-Founderbrain-{email}
#   lifetime spend: $20 with limit_reset=null (never renews)
#   expires: 30 days after creation
# Stored encrypted server-side only; revoked on workspace delete.
