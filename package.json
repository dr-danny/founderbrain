{
  "name": "founderbrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FounderBrain SaaS (Railway + Cloudflare + Hexclave) plus the inherited Launchhouse runtime reference. Public source; no founder data or credentials.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "TZ=UTC tsx watch src/server/index.ts",
    "dev:web": "vite",
    "prestart": "npm run build:web || echo 'The screens did not build. Starting anyway, so you get a page that says what to do rather than an address that never answers.'",
    "start": "TZ=UTC tsx src/server/index.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && { [ -d src/web ] && tsc -p tsconfig.web.json --noEmit || echo 'src/web is not present yet, skipping the browser typecheck'; }",
    "test": "node --import tsx --test --test-timeout=30000 \"tests/**/*.test.ts\" \"src/**/*.test.ts\" \"app/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch --test-timeout=30000 \"tests/**/*.test.ts\" \"src/**/*.test.ts\" \"app/**/*.test.ts\"",
    "lint": "eslint .",
    "probe": "tsx scripts/probe-deployment.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "skills:gen": "tsx scripts/gen-skill-prompts.ts",
    "engine:bump": "tsx scripts/bump-engine.ts",
    "seed": "tsx scripts/seed.ts",
    "purge:tokens": "tsx scripts/purge-tokens.ts",
    "prove:turn": "tsx scripts/prove-turn.ts",
    "prove:init": "tsx scripts/prove-init.ts",
    "prebuild": "tsx scripts/check-replit-config.ts",
    "fb:dev": "TZ=UTC tsx src/founderbrain/main.ts",
    "fb:worker": "TZ=UTC tsx src/founderbrain/worker.ts",
    "fb:migrate": "TZ=UTC tsx src/founderbrain/migrate-main.ts",
    "fb:build": "tsc -p tsconfig.founderbrain.json && tsc -p tsconfig.founderbrain-web.json && vite build --config vite.founderbrain.config.ts && tsc -p tsconfig.founderbrain-runtime.json && node scripts/founderbrain-copy-sql.mjs",
    "fb:test": "TZ=UTC node --import tsx --test --test-concurrency=1 src/founderbrain/*.test.ts src/founderbrain-edge/*.test.ts src/founderbrain-web/lib/*.test.ts",
    "fb:preview": "vite --config vite.founderbrain.config.ts",
    "fb:reconcile": "TZ=UTC tsx src/founderbrain/reconcile-main.ts",
    "fb:local-db": "bash scripts/founderbrain-local-db.sh",
    "fb:check-runtime-deps": "node scripts/founderbrain-check-runtime-deps.mjs",
    "format": "prettier --write \"src/founderbrain*/**/*.{ts,tsx,css,json}\" \"src/founderbrain-shared/**/*.ts\"",
    "format:check": "prettier --check \"src/founderbrain*/**/*.{ts,tsx,css,json}\" \"src/founderbrain-shared/**/*.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.258",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@hexclave/js": "^1.0.121",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "esbuild-wasm": "^0.28.2",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "wrangler": "^4.133.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "rollup": "npm:@rollup/wasm-node@4.63.3"
  }
}
